generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  cards        Card[]
  transactions Transaction[]
}

model Card {
  id            String @id @default(uuid())
  userId        String
  token         String @unique
  encryptedPan  String
  iv            String
  lastFour      String
  expMonth      Int
  expYear       Int
  brand         String

  user          User @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id               String @id @default(uuid())
  userId           String
  cardId           String
  status           String
  amount           Int
  currency         String
  authCode         String?
  retryCount       Int @default(0)
  correlationId    String

  user             User @relation(fields: [userId], references: [id])
  card             Card @relation(fields: [cardId], references: [id])
}